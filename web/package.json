{
  "name": "moog-saw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "node scripts/copy-wasm.mjs",
    "wasm:watch": "cargo-watch -x \"build --release --target wasm32-unknown-unknown -p moog_saw_wasm\" -s \"node web/scripts/copy-wasm.mjs\" -i \"web/src/lib/moog-saw.wasm\"",
    "vite": "vite",
    "dev": "run-p wasm:watch vite",
    "build": "run-s wasm:build tsc vite:build",
    "tsc": "tsc --noEmit",
    "vite:build": "vite build",
    "lib": "node scripts/build-lib.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
